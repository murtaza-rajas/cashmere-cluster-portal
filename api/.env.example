# Copy to .env and fill in real values. Never commit .env.

# Local/dev DB only — production DB credentials live in the Norway-hosted environment,
# never in this repo (see PROJECT_TRACKER.md Section 4, GDPR/Security).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cashmere_lovers_club?schema=public"

# Shopify Customer Account API (see src/auth/providers/shopify-identity.provider.ts)
# Set up in the Shopify admin under the app's [customer_authentication] config —
# needs the client's actual Shopify custom app before this can be tested end-to-end.
SHOPIFY_SHOP_DOMAIN="your-store.myshopify.com"   # no https:// prefix
SHOPIFY_CLIENT_ID="replace-with-real-client-id"
SHOPIFY_REDIRECT_URI="https://your-staging-url/auth/shopify/callback"  # must be HTTPS — localhost is not accepted by Shopify

# Our own session JWT (not Shopify's token) — generate a long random value for real environments.
JWT_SECRET="replace-with-a-long-random-value"

# Staff session JWT — deliberately a DIFFERENT secret from JWT_SECRET above, so a member
# session can never be replayed as a staff session. No staff login flow exists yet
# (pending the Milestone 1 auth evaluation) — this just needs to be set for the app to boot.
STAFF_JWT_SECRET="replace-with-a-different-long-random-value"

# Where to send the browser after a successful login.
FRONTEND_URL="http://localhost:3001"

# Cookie domain for the session cookie so the frontend (members.cashmerehouse.com) and
# backend (e.g. api.members.cashmerehouse.com) can share it. Leave unset for local dev.
COOKIE_DOMAIN=
