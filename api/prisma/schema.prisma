// Cashmere Lovers Club — Phase 1 data model
//
// Design principles this schema follows (see PROJECT_TRACKER.md for full context):
// - Shopify is the source of truth for member identity, contact details and orders.
//   This database only stores membership-specific data that doesn't already live in Shopify
//   (data minimisation — see PROJECT_TRACKER.md Section 4, GDPR/Security).
// - No payment/card data is ever stored here. Orders are a read-only summary cache.
// - Founding Member status is a PERMANENT flag, decoupled from the paid term itself —
//   confirmed by the client: the badge survives even if the 5-year term lapses without renewal.
// - Staff roles are 8 fixed presets (not a fully dynamic permission engine) but modelled as
//   real rows (Role/StaffRoleAssignment), not a hardcoded enum, so the model can extend later
//   without a schema rewrite if DCC needs more advanced access management (client requirement).
// - Every sensitive administrative action is expected to write an AuditLog row.
// - Region (community), membership tier, and language are deliberately separate,
//   orthogonal fields on Member — not hardcoded together — so a regional community
//   (e.g. Mongolia) can have its own tier/pricing/language without implying the
//   commercial benefits of the international paid tiers. Client requirement,
//   PROJECT_TRACKER.md Section 3a.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Membership
// ---------------------------------------------------------------------------

enum MembershipTier {
  FOUNDING   // First 1,500 paying members. Cap enforced via Shopify inventory, not here.
  ANNUAL     // Paid, 1-year or 5-year term (see termLengthYears).
  MONGOLIA   // Mongolia Community membership — separate price (free or ~$5/yr, TBD), scoped to
             // the `region` field below. Deliberately its own tier rather than reusing NEWSLETTER
             // or ANNUAL: it must never be inferred as carrying FOUNDING/ANNUAL's international
             // commercial benefits. See PROJECT_TRACKER.md Section 3a.
  NEWSLETTER // Free tier. Existing Shopify customers/newsletter subscribers land here by default.
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// Community/region a member belongs to — kept independent of MembershipTier on purpose
// (client requirement, PROJECT_TRACKER.md Section 3a): region, membership tier, and
// language must stay separate, orthogonal fields rather than hardcoded together.
enum Region {
  INTERNATIONAL
  MONGOLIA
}

// Independent of Region — e.g. a Mongolian member abroad may prefer English, or an
// international member may prefer Mongolian. Never derive this from `region`.
enum Language {
  ENGLISH
  MONGOLIAN
}

model Member {
  id     String @id @default(uuid())

  // Shopify is the identity source of truth. We never store a password here —
  // login happens via Shopify Customer Accounts (OAuth), see PROJECT_TRACKER.md Section 3.
  shopifyCustomerId String @unique

  // Cached for admin search/display convenience only. Shopify remains authoritative;
  // this field is refreshed via webhook and purged on a Shopify customers/redact event.
  email     String
  firstName String?
  lastName  String?

  membershipTier   MembershipTier
  membershipStatus MembershipStatus @default(ACTIVE)

  // Independent of membershipTier — see the Region/Language enum comments above.
  region   Region   @default(INTERNATIONAL)
  language Language @default(ENGLISH)

  // Permanent once true — do NOT derive this from membershipStatus/expiry.
  // Client requirement: Founding Member badge stays for life even if the term isn't renewed.
  isFoundingMember Boolean @default(false)

  // Term tracking. Null for the free NEWSLETTER tier.
  termLengthYears     Int?      // 1 or 5
  membershipStartDate DateTime?
  membershipEndDate   DateTime?

  // The Shopify order that granted the current paid term, for support/audit reference.
  originatingShopifyOrderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders               MemberOrderCache[]
  wishlistItems        WishlistItem[]
  dataSubjectRequests  DataSubjectRequest[]
  auditLogEntries      AuditLog[]           @relation("AuditLogTargetMember")
  designFavorites      DesignFavorite[]
  designVotes          DesignVote[]
  mongoliaProducerVotes MongoliaProducerVote[]

  @@index([membershipTier])
  @@index([region])
  @@index([email])
}

// Read-only summary cache of Shopify orders, kept in sync via webhook.
// Shopify remains the system of record — we never store payment/card details here.
model MemberOrderCache {
  id             String   @id @default(uuid())
  memberId       String
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  shopifyOrderId String   @unique
  orderNumber    String
  totalAmount    Decimal  @db.Decimal(10, 2)
  currency       String
  status         String   // Shopify's order/financial status string, cached as-is
  orderDate      DateTime

  // Line items from the same order webhook payload, cached as JSON rather than a
  // separate relational table — this is a read-only display cache (feeds "My
  // Collection"), never queried/filtered relationally, so a table+joins would be
  // unneeded complexity. Shape: [{ productId, title, variantTitle, quantity, price }].
  // Null for rows synced before this field existed.
  lineItems Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
}

// A member's saved products. Real feature per the client's confirmed Wishlist
// flow (PROJECT_TRACKER.md Section 3c): "Add to Wishlist" on a CashmereHouse.com
// product page saves it here, shown under "My Wishlist" in the portal. This is
// our side of that integration; the storefront side (how the click on
// CashmereHouse.com actually authenticates and calls this) is a separate,
// unresolved design question — see the tracker — so this table has no writer
// yet beyond this API's own endpoint.
model WishlistItem {
  id     String @id @default(uuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  shopifyProductId String
  title            String
  variantTitle     String?
  price            String?

  addedAt DateTime @default(now())

  @@unique([memberId, shopifyProductId])
  @@index([memberId])
}

// ---------------------------------------------------------------------------
// Staff, roles & permissions
// ---------------------------------------------------------------------------
// 8 fixed role presets (per client confirmation, PROJECT_TRACKER.md Section 3):
// Club Manager, Content Manager, Newsletter Manager, Member Support, Commerce Manager,
// Event Manager, Analytics Viewer, Technical Administrator, Investor Relations Manager
// — plus Super Administrator. Seeded via prisma/seed.ts, not user-creatable in Phase 1
// (that would be the "fully dynamic permission builder" we deliberately deferred).

model StaffUser {
  id    String @id @default(uuid())
  email String @unique
  name  String

  // Kept provider-agnostic on purpose: staff aren't Shopify customers, so this points at
  // whatever identity provider ends up used for internal accounts (see auth evaluation,
  // Milestone 1 deliverable) without forcing a schema change later.
  authProviderId String? @unique

  isActive    Boolean   @default(true)
  startDate   DateTime  @default(now())
  expiryDate  DateTime? // optional, per the client's spec (PDF Section 6)
  mfaEnabled  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleAssignments      StaffRoleAssignment[] @relation("AssignmentsForStaff")
  grantedAssignments    StaffRoleAssignment[] @relation("AssignmentsGrantedBy")
  auditLogEntries       AuditLog[]            @relation("AuditLogActor")
  createdBenefits       Benefit[]             @relation("BenefitsCreatedBy")
  uploadedSiteImages    SiteImage[]           @relation("SiteImagesUploadedBy")
  createdEvents         Event[]               @relation("EventsCreatedBy")
  updatedCareGuides     CareGuide[]           @relation("CareGuidesUpdatedBy")
  createdDesigns        Design[]              @relation("DesignsCreatedBy")
  createdMongoliaStories MongoliaStory[]       @relation("MongoliaStoriesCreatedBy")
  createdMongoliaProducers MongoliaProducer[]  @relation("MongoliaProducersCreatedBy")

  @@index([email])
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique // e.g. "Club Manager", "Super Administrator"
  description String?

  assignments StaffRoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A staff member's grant of one role, optionally scoped to a subset of data
// (e.g. "assigned designers only") rather than the full module.
model StaffRoleAssignment {
  id String @id @default(uuid())

  staffUserId String
  staffUser   StaffUser @relation("AssignmentsForStaff", fields: [staffUserId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Free-form scope description/filter, e.g. { "scope": "all" } or a list of record IDs.
  // Kept as JSON rather than new tables per module — Phase 1 doesn't need a data-scope
  // engine beyond "all vs. specific IDs", but this avoids a migration if that changes.
  dataScope Json @default("{\"scope\": \"all\"}")

  grantedById String?
  grantedBy   StaffUser? @relation("AssignmentsGrantedBy", fields: [grantedById], references: [id])
  grantedAt   DateTime   @default(now())

  @@unique([staffUserId, roleId])
}

// ---------------------------------------------------------------------------
// Audit log — every sensitive administrative action must write a row here.
// ---------------------------------------------------------------------------

model AuditLog {
  id String @id @default(uuid())

  actorStaffUserId String?
  actorStaffUser   StaffUser? @relation("AuditLogActor", fields: [actorStaffUserId], references: [id])

  action     String // e.g. "member.status_changed", "staff.role_granted", "member.data_exported"
  targetType String // e.g. "Member", "StaffUser"
  targetId   String

  // Convenience relation for the common case of a Member being the target — makes
  // "show this member's full history" a simple query. targetType/targetId above stay
  // the source of truth for anything else (StaffUser, Role, etc.).
  targetMemberId String?
  // Explicit SetNull (confirmed this was already Prisma's implicit default for an
  // optional relation, but stated outright since it matters for GDPR redaction:
  // deleting a Member must not be blocked by audit history referencing it — the
  // audit trail of the redaction event itself is what matters, not keeping the FK alive).
  targetMember   Member? @relation("AuditLogTargetMember", fields: [targetMemberId], references: [id], onDelete: SetNull)

  reason   String? // required by the client's spec for exceptions/deletions
  metadata Json?   // before/after snapshot, free-form

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Offers & Benefits (Milestone 5 content curation)
// ---------------------------------------------------------------------------
// Replaces two previously-hardcoded pieces of content with real, staff-editable
// rows: the My Benefits table (client's confirmed per-tier list, PROJECT_TRACKER.md
// Section 3c) and the Member Offers catalog (previously just a placeholder — no
// data model existed for it at all). Same model, distinguished by `type`, since
// both are "a titled thing shown to certain tiers" — a benefit is a fixed
// membership perk, an offer is a more rotating/time-limited promotion, but
// neither needs a structurally different shape.

enum BenefitType {
  BENEFIT // My Benefits — fixed per-tier perks (term, discount, welcome gift, etc.)
  OFFER   // Member Offers — rotating/time-limited offers catalog
}

model Benefit {
  id String @id @default(uuid())

  type BenefitType

  // Which tiers see this row. Deliberately explicit per-row rather than derived
  // from anything else — an empty array means visible to nobody (a draft row),
  // not "everyone", so a half-configured row can never accidentally leak to a
  // tier it wasn't meant for.
  tiers MembershipTier[]

  // 2026-09-11 — added when reusing this model for Mongolia's "Current
  // Offers" surfaced a real gap: MembershipTier alone can't distinguish
  // "Mongolia Newsletter" from an international Newsletter Subscriber —
  // both carry tier NEWSLETTER, region is the only thing that tells them
  // apart (see Member.region's own comment). Defaults to both regions so
  // every existing row (all international, created before Mongolia had any
  // content of its own) keeps working exactly as before — nobody has to
  // backfill anything. A Mongolia-scoped row explicitly sets [MONGOLIA].
  regions Region[] @default([INTERNATIONAL, MONGOLIA])

  // lucide-react icon name (see web/lib/benefit-icons.ts for the fixed set staff
  // can choose from); null renders a sensible default icon client-side.
  icon        String?
  title       String
  description String?

  // Staff-controlled display order (ascending); ties broken by createdAt.
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   StaffUser? @relation("BenefitsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([type])
}

// ---------------------------------------------------------------------------
// Tier-specific images (staff-uploaded, replacing bundled static photos)
// ---------------------------------------------------------------------------
// A handful of member-facing pages show a hero photo that was previously a
// single bundled file in web/public/images, the same for every member
// regardless of tier. This lets staff upload a different real photo per
// (slot, tier) pair instead of a code change. `slot` is a fixed enum, not a
// free-form string — each value corresponds to one specific, already-wired
// spot in the frontend, not an arbitrary/unbounded set of "make up a slot
// name" possibilities that nothing would actually render.

enum SiteImageSlot {
  DASHBOARD_HERO
  CARE_REPAIR_HERO
  SIDEBAR_HELP // The member sidebar's bottom "Need Help?" photo (components/sidebar.tsx)
}

model SiteImage {
  id String @id @default(uuid())

  slot SiteImageSlot
  tier MembershipTier

  // Public path the uploaded file is served from (see main.ts's
  // useStaticAssets), e.g. "/uploads/site-images/dashboard-hero-founding-....jpeg".
  // The physical file lives on local disk for now (uploads/site-images/) —
  // fine for a single-instance dev/staging deployment, but will need to move
  // to real object storage (matching whatever the Norway-hosting decision
  // ends up being, PROJECT_TRACKER.md Section 4) before a multi-instance or
  // ephemeral-filesystem production deployment.
  url String

  uploadedAt   DateTime  @default(now())
  uploadedById String?
  uploadedBy   StaffUser? @relation("SiteImagesUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  // One image per (slot, tier) — uploading again replaces it (old file
  // deleted from disk), never adds a second row.
  @@unique([slot, tier])
}

// ---------------------------------------------------------------------------
// Events & Invitations (Milestone 5 content curation)
// ---------------------------------------------------------------------------
// Replaces the two hardcoded dummy events on the member-facing Invitations &
// Events page (client's own suggested placeholders, PROJECT_TRACKER.md
// Section 3c — "Mongolia Evening", "Meet the Designer") with real,
// staff-manageable rows. Fields match what the client asked for: image,
// title, date/time, location-or-online, description, eligible tiers,
// registration link.

enum EventLocationType {
  IN_PERSON
  ONLINE
}

model Event {
  id String @id @default(uuid())

  title       String
  description String?

  locationType EventLocationType
  // Free text either way — a venue address for IN_PERSON, or a platform name
  // ("Zoom", "Instagram Live") for ONLINE. Optional: the client's own dummy
  // events shipped with only "In person"/"Online" and no further detail.
  location String?

  // Null renders the same honest "Date to be announced" placeholder the
  // hardcoded dummy events already used — not every event has a confirmed
  // date the moment staff start drafting it.
  startsAt DateTime?

  // Null renders the same honest disabled "Registration opening soon" state
  // already shipped — Phase 1 registration is just an external link (client's
  // own words), not a booking system built here.
  registrationUrl String?

  // Uploaded photo — same disk-storage pattern as SiteImage (see its comment
  // on the local-disk vs. object-storage tradeoff). Null renders the existing
  // icon placeholder, same as the hardcoded events did with no real
  // photography yet.
  imageUrl String?

  // Which tiers see this event. Empty = draft, visible to nobody — same
  // convention as Benefit.tiers, so a half-configured event never leaks.
  tiers MembershipTier[]

  // Same reasoning and default as Benefit.regions — tier alone can't tell
  // Mongolia Newsletter apart from an international Newsletter Subscriber.
  regions Region[] @default([INTERNATIONAL, MONGOLIA])

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   StaffUser? @relation("EventsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([active])
}

// Founders' Design Lab (client email 2026-09-07/08) — international portal
// only, per the client's own written scope ("new tab, international portal
// only"). Access is tier-differentiated in a way no other portal area is:
// confirmed directly from the three real tier-homepage mockups (Founder/
// Annual/Newsletter), not guessed at — Founding gets a full dedicated nav
// tab (view + save + vote), Annual gets a homepage teaser leading to a
// preview (view + save, no vote — its own mockup card never mentions
// voting), Newsletter has no presence at all, Mongolia isn't shown anywhere
// (out of scope for this specific feature). See web/lib/access.ts.
enum DesignStatus {
  CURRENT
  SELECTED_FOR_PRODUCTION
  PAST_ROUND
}

model Design {
  id String @id @default(uuid())

  title       String
  description String?

  // Freeform, staff-provided — the mockup's own example ("Spring 2027") isn't
  // from a fixed list of seasons/rounds, and future rounds aren't known yet.
  round String?

  status DesignStatus @default(CURRENT)

  // Chip-style tags on each design card in the mockup ("Lightweight",
  // "Everyday", "Versatile").
  tags String[]

  // The mockup's own three image slots per design: the worn/hero photo, a
  // fabric swatch close-up, and a flat sketch. Same disk-storage pattern and
  // nullable-until-uploaded convention as Event/SiteImage — a design can be
  // drafted with text content before any photography exists for it.
  heroImageUrl   String?
  swatchImageUrl String?
  sketchImageUrl String?

  // Same "draft, not yet visible to anybody" convention as Benefit/Event —
  // status/round alone don't gate visibility, active does.
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   StaffUser? @relation("DesignsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  favorites DesignFavorite[]
  votes     DesignVote[]

  @@index([active])
  @@index([status])
}

// Save/heart — every tier with any Design Lab access at all (Founding,
// Annual) can do this. Separate from DesignVote below: confirmed as two
// genuinely distinct actions, not a UI-only distinction, directly from the
// Annual-tier mockup's own teaser copy ("Save your favourites and follow the
// journey") — it names saving specifically while never mentioning voting,
// matching the dashboard mockup's two visually separate buttons.
model DesignFavorite {
  id String @id @default(uuid())

  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([designId, memberId])
}

// Vote — Founding-only ("in selected cases vote," per the client's email;
// the mockups confirm Founding is that selected case). Enforced server-side
// in the service layer, not just hidden in the UI, matching this project's
// established "must be blocked even via direct URL" discipline for every
// other tier-gated action.
model DesignVote {
  id String @id @default(uuid())

  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([designId, memberId])
}

// Cashmere Lovers Club Mongolia (client emails 2026-09-07/08/09) — a
// deliberately separate section, not a translated copy of the international
// portal (client's own words). Content types built so far: Stories & News,
// then Producer profiles — both named in the client's confirmed content list
// for both Mongolia levels (2026-09-09 email, "Access Structure for the
// Mongolia Section"). The photo archive (with submission + moderation),
// voting (on producers/community development — depends on producers
// existing, built now), and Mongolia-specific offers are real, named, later
// pieces of the same section — not built yet, tracked separately in
// PROJECT_TRACKER.md Section 3d, not guessed at here.
//
// Only two Mongolia levels exist (Mongolia Newsletter / Mongolia Founding
// Member — modeled as membershipTier NEWSLETTER/MONGOLIA with region MONGOLIA,
// per the 2026-09-01/08 architecture decisions, no schema change needed for
// that part). The client's content list gives Newsletter "selected stories"
// and Founding "full" story access — modeled as foundingOnly rather than a
// tiers array (unlike Benefit/Event's 4-tier international model) since
// there are genuinely only two possible audiences here.
model MongoliaStory {
  id String @id @default(uuid())

  title   String
  excerpt String?
  body    String?

  // Freeform, staff-provided — the client's email didn't give a fixed
  // category list for Mongolia stories, same reasoning as Design.round.
  category String?

  heroImageUrl String?

  // false = visible to both Mongolia levels ("selected stories" for
  // Newsletter). true = Founding-only ("full" story access).
  foundingOnly Boolean @default(false)

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   StaffUser? @relation("MongoliaStoriesCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([active])
}

// Second Mongolia content type (client's 2026-09-09 content list: Newsletter
// gets "selected producer content", Founding gets "full stories/producer
// content") — same foundingOnly split as MongoliaStory, same reasoning.
model MongoliaProducer {
  id String @id @default(uuid())

  name     String
  craft    String? // e.g. "Cashmere herding", "Weaving" — freeform, no fixed list given
  location String?
  story    String?

  heroImageUrl String?

  foundingOnly Boolean @default(false)

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   StaffUser? @relation("MongoliaProducersCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  votes MongoliaProducerVote[]

  @@index([active])
}

// "Your voice" — voting on producers, per the client's 2026-09-09 email
// ("Founding Member: ...voting on producers and community development") and
// the client's own mockup (2.5 CLC MN Founder Mobil.png's "Which producer
// should we feature next?" widget). Founding-only, same split and same
// upsert-based one-vote-per-member shape as DesignVote above — Mongolia
// Founding is the section's "selected cases vote" tier, same reasoning.
model MongoliaProducerVote {
  id String @id @default(uuid())

  producerId String
  producer   MongoliaProducer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([producerId, memberId])
}

// ---------------------------------------------------------------------------
// Care & Repair guides (Milestone 5 content curation)
// ---------------------------------------------------------------------------
// The client's own instruction (PROJECT_TRACKER.md Section 3c) was
// deliberately "structure and templates only for now" — the five topics
// themselves (washing, storage, pilling, repairs, longevity) are the
// client's own confirmed, fixed list, not something staff invent or
// reorder, so `topic` is a fixed enum rather than a free-form/creatable
// row like Benefit or Event. What staff actually need to manage is just
// each topic's guide text, added "continuously after launch" per the
// client's own words — so this is deliberately a narrower model than
// Benefit/Event: no create/delete, just update-the-body-per-topic. Every
// topic row is seeded up front (prisma/seed.ts) so there are always
// exactly five, never a missing or duplicate topic.

enum CareGuideTopic {
  WASHING
  STORAGE
  PILLING
  REPAIRS
  LONGEVITY
}

model CareGuide {
  id String @id @default(uuid())

  topic CareGuideTopic @unique

  // Null keeps the existing "Guide coming soon" placeholder on the member
  // page — real content lands here incrementally, not all at once.
  body String?

  updatedAt   DateTime  @updatedAt
  updatedById String?
  updatedBy   StaffUser? @relation("CareGuidesUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// GDPR data-subject requests
// ---------------------------------------------------------------------------

enum DataSubjectRequestType {
  ACCESS
  EXPORT
  DELETION
}

enum DataSubjectRequestStatus {
  PENDING
  COMPLETED
}

model DataSubjectRequest {
  id String @id @default(uuid())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  type   DataSubjectRequestType
  status DataSubjectRequestStatus @default(PENDING)

  // Set when triggered by Shopify's mandatory compliance webhooks
  // (customers/data_request, customers/redact) rather than a member-initiated request.
  sourceShopifyWebhookId String?

  requestedAt DateTime  @default(now())
  completedAt DateTime?

  @@index([memberId])
  @@index([status])
}
